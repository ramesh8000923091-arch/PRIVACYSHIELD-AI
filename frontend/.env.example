# PrivacyShield AI — Optional Environment Variables
# ------------------------------------------------------------------
# PrivacyShield AI works 100% locally WITHOUT any backend credentials.
# Leave these blank to run in Local-Only Mode.
#
# When configured, Supabase is used ONLY for:
# - Optional user authentication
# - Synced UI preferences (theme, default redaction mode)
# - Explicitly consented, non-sensitive aggregate entity counts
#
# NEVER store or send raw documents, PII values, or pseudonym maps.
# ------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
